{%- comment -%}
  Hroofy | حروفي — Playful Kids Hero (Toy UI / Claymorphism)
  - RTL-first (uses CSS logical properties), works in LTR too.
  - Floating animated SVG crayons, stars, letters and numbers.
  - Trust badges are blocks (drag & drop in the Theme Customizer).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign hero_id = 'hroofy-hero-' | append: section.id
-%}

{% style %}
  #{{ hero_id }} {
    --hh-bg-1: {{ s.bg_color_1 }};
    --hh-bg-2: {{ s.bg_color_2 }};
    --hh-text: {{ s.text_color }};
    --hh-accent: {{ s.accent_color }};
    --hh-btn: {{ s.button_color }};
    --hh-btn-text: {{ s.button_text_color }};
    --hh-btn-shadow: {{ s.button_color | color_darken: 18 }};
    --hh-pad-top: {{ s.padding_top }}px;
    --hh-pad-bottom: {{ s.padding_bottom }}px;
  }

  .hroofy-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--hh-text);
    background:
      radial-gradient(circle at 12% 20%, rgb(255 255 255 / 0.55) 0 12%, transparent 13%),
      radial-gradient(circle at 88% 78%, rgb(255 255 255 / 0.45) 0 10%, transparent 11%),
      linear-gradient(135deg, var(--hh-bg-1) 0%, var(--hh-bg-2) 100%);
    padding-block: var(--hh-pad-top) var(--hh-pad-bottom);
    font-family: var(--font-body--family, 'Cairo', system-ui, sans-serif);
  }

  .hroofy-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  @media screen and (min-width: 990px) {
    .hroofy-hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
    }
  }

  .hroofy-hero__content {
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .hroofy-hero__content {
      text-align: start;
    }
  }

  .hroofy-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 999px;
    background: #ffffff;
    color: var(--hh-text);
    font-weight: 700;
    font-size: 15px;
    box-shadow:
      0 6px 0 rgb(0 0 0 / 0.08),
      inset 0 -3px 0 rgb(0 0 0 / 0.06);
    margin-block-end: 18px;
  }

  .hroofy-hero__eyebrow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hh-accent);
    animation: hroofy-pulse 1.6s ease-in-out infinite;
  }

  .hroofy-hero__title {
    font-family: var(--font-heading--family, 'Baloo Bhaijaan 2', 'Cairo', sans-serif);
    font-weight: 800;
    font-size: clamp(34px, 6vw, 64px);
    line-height: 1.15;
    margin: 0 0 18px;
    letter-spacing: 0;
    color: var(--hh-text);
  }

  .hroofy-hero__highlight {
    position: relative;
    display: inline-block;
    color: var(--hh-accent);
    white-space: nowrap;
  }

  .hroofy-hero__highlight::after {
    content: '';
    position: absolute;
    inset-inline: -4px;
    bottom: 2px;
    height: 0.32em;
    background: var(--hh-btn);
    opacity: 0.25;
    border-radius: 999px;
    z-index: -1;
  }

  .hroofy-hero__sub {
    font-size: clamp(16px, 2.2vw, 20px);
    line-height: 1.8;
    max-width: 560px;
    margin-inline: auto;
    margin-block-end: 28px;
    opacity: 0.9;
  }

  @media screen and (min-width: 990px) {
    .hroofy-hero__sub {
      margin-inline: 0;
    }
  }

  .hroofy-hero__sub p {
    margin: 0;
  }

  .hroofy-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-block-end: 30px;
  }

  @media screen and (min-width: 990px) {
    .hroofy-hero__actions {
      justify-content: flex-start;
    }
  }

  .hroofy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 14px 32px;
    border-radius: 999px;
    font-family: var(--font-heading--family, 'Baloo Bhaijaan 2', 'Cairo', sans-serif);
    font-weight: 800;
    font-size: 18px;
    text-decoration: none;
    cursor: pointer;
    border: 0;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .hroofy-btn--primary {
    background: var(--hh-btn);
    color: var(--hh-btn-text);
    box-shadow:
      0 7px 0 var(--hh-btn-shadow),
      0 14px 28px rgb(0 0 0 / 0.16);
    animation: hroofy-wiggle 4s ease-in-out infinite;
  }

  .hroofy-btn--primary:hover {
    transform: translateY(-3px);
    box-shadow:
      0 10px 0 var(--hh-btn-shadow),
      0 18px 32px rgb(0 0 0 / 0.18);
  }

  .hroofy-btn--primary:active {
    transform: translateY(5px);
    box-shadow:
      0 2px 0 var(--hh-btn-shadow),
      0 6px 12px rgb(0 0 0 / 0.14);
  }

  .hroofy-btn--secondary {
    background: #ffffff;
    color: var(--hh-text);
    box-shadow:
      0 6px 0 rgb(0 0 0 / 0.1),
      inset 0 0 0 3px var(--hh-accent);
  }

  .hroofy-btn--secondary:hover {
    transform: translateY(-3px);
  }

  .hroofy-btn:focus-visible {
    outline: 4px dashed var(--hh-accent);
    outline-offset: 4px;
  }

  .hroofy-btn__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  [dir='rtl'] .hroofy-btn__arrow {
    transform: scaleX(-1);
  }

  .hroofy-btn:hover .hroofy-btn__arrow {
    transform: translateX(4px);
  }

  [dir='rtl'] .hroofy-btn:hover .hroofy-btn__arrow {
    transform: scaleX(-1) translateX(4px);
  }

  .hroofy-hero__badges {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .hroofy-hero__badges {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr));
    }
  }

  .hroofy-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 22px;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    box-shadow:
      0 6px 0 rgb(0 0 0 / 0.06),
      inset 0 -4px 0 rgb(0 0 0 / 0.04),
      inset 0 3px 0 rgb(255 255 255 / 0.9);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    text-align: start;
  }

  .hroofy-badge__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: var(--badge-color, var(--hh-accent));
    color: #ffffff;
    box-shadow: inset 0 -4px 0 rgb(0 0 0 / 0.14);
  }

  .hroofy-badge__icon svg {
    width: 22px;
    height: 22px;
  }

  .hroofy-hero__visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hroofy-hero__blob {
    position: absolute;
    inset: 6%;
    border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    background: #ffffff;
    opacity: 0.55;
    animation: hroofy-morph 12s ease-in-out infinite;
  }

  .hroofy-hero__media {
    position: relative;
    width: min(100%, 460px);
    border-radius: 36px;
    overflow: hidden;
    transform: rotate(-3deg);
    box-shadow:
      0 18px 0 rgb(0 0 0 / 0.07),
      0 30px 60px rgb(0 0 0 / 0.18);
    animation: hroofy-bob 6s ease-in-out infinite;
  }

  .hroofy-hero__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hroofy-hero__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .hroofy-hero__sticker {
    position: absolute;
    inset-block-start: 4%;
    inset-inline-end: 4%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 108px;
    height: 108px;
    padding: 10px;
    border-radius: 50%;
    background: var(--hh-btn);
    color: var(--hh-btn-text);
    font-family: var(--font-heading--family, 'Baloo Bhaijaan 2', 'Cairo', sans-serif);
    font-weight: 800;
    font-size: 19px;
    line-height: 1.2;
    text-align: center;
    box-shadow:
      0 6px 0 var(--hh-btn-shadow),
      0 12px 24px rgb(0 0 0 / 0.18);
    transform: rotate(12deg);
    animation: hroofy-spin-wobble 5s ease-in-out infinite;
  }

  .hroofy-hero__floaters {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hroofy-floater {
    position: absolute;
    top: var(--y);
    inset-inline-start: var(--x);
    width: var(--size, 48px);
    height: auto;
    opacity: var(--o, 0.9);
    animation: hroofy-float var(--d, 7s) ease-in-out var(--delay, 0s) infinite;
  }

  .hroofy-floater--glyph {
    width: auto;
    font-family: var(--font-heading--family, 'Baloo Bhaijaan 2', 'Cairo', sans-serif);
    font-weight: 800;
    font-size: var(--size, 48px);
    line-height: 1;
    color: var(--c, #ffffff);
    -webkit-text-stroke: 3px rgb(43 45 66 / 0.18);
    text-shadow: 0 5px 0 rgb(0 0 0 / 0.08);
  }

  @media screen and (max-width: 749px) {
    .hroofy-floater--hide-mobile {
      display: none;
    }
  }

  @keyframes hroofy-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-22px) rotate(8deg);
    }
  }

  @keyframes hroofy-bob {
    0%,
    100% {
      transform: rotate(-3deg) translateY(0);
    }
    50% {
      transform: rotate(-1deg) translateY(-12px);
    }
  }

  @keyframes hroofy-morph {
    0%,
    100% {
      border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    }
    50% {
      border-radius: 61% 39% 38% 62% / 56% 61% 39% 44%;
    }
  }

  @keyframes hroofy-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.55;
    }
  }

  @keyframes hroofy-wiggle {
    0%,
    86%,
    100% {
      rotate: 0deg;
    }
    89% {
      rotate: -3deg;
    }
    92% {
      rotate: 3deg;
    }
    95% {
      rotate: -2deg;
    }
  }

  @keyframes hroofy-spin-wobble {
    0%,
    100% {
      transform: rotate(12deg) scale(1);
    }
    50% {
      transform: rotate(-6deg) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hroofy-hero *,
    .hroofy-hero *::before,
    .hroofy-hero *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstyle %}

<section
  id="{{ hero_id }}"
  class="hroofy-hero"
  aria-labelledby="{{ hero_id }}-title"
>
  {%- if s.show_floaters -%}
    <div class="hroofy-hero__floaters" aria-hidden="true">
      {%- comment -%} Crayon 1 {%- endcomment -%}
      <svg
        class="hroofy-floater"
        style="--x: 4%; --y: 12%; --size: 74px; --d: 8s;"
        viewBox="0 0 120 40"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="18" y="8" width="84" height="24" rx="6" fill="#FF6B4A"/>
        <rect x="30" y="8" width="10" height="24" fill="#E2553A"/>
        <rect x="80" y="8" width="10" height="24" fill="#E2553A"/>
        <path d="M18 8 L2 20 L18 32 Z" fill="#FFC9B8"/>
        <path d="M8 16 L2 20 L8 24 Z" fill="#E2553A"/>
        <rect x="100" y="8" width="16" height="24" rx="5" fill="#2B2D42"/>
      </svg>

      {%- comment -%} Crayon 2 {%- endcomment -%}
      <svg
        class="hroofy-floater hroofy-floater--hide-mobile"
        style="--x: 46%; --y: 84%; --size: 86px; --d: 9s; --delay: -2s;"
        viewBox="0 0 120 40"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="18" y="8" width="84" height="24" rx="6" fill="#2EC4B6"/>
        <rect x="30" y="8" width="10" height="24" fill="#22A69A"/>
        <rect x="80" y="8" width="10" height="24" fill="#22A69A"/>
        <path d="M18 8 L2 20 L18 32 Z" fill="#BFF2EC"/>
        <path d="M8 16 L2 20 L8 24 Z" fill="#22A69A"/>
        <rect x="100" y="8" width="16" height="24" rx="5" fill="#2B2D42"/>
      </svg>

      {%- comment -%} Stars {%- endcomment -%}
      <svg
        class="hroofy-floater"
        style="--x: 90%; --y: 10%; --size: 46px; --d: 6s; --delay: -1s;"
        viewBox="0 0 50 50"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M25 3 L31 18 L47 19 L34 29 L39 45 L25 36 L11 45 L16 29 L3 19 L19 18 Z" fill="#FFD23F" stroke="#2B2D42" stroke-width="3" stroke-linejoin="round"/>
      </svg>
      <svg
        class="hroofy-floater"
        style="--x: 58%; --y: 6%; --size: 30px; --d: 7s; --delay: -3s;"
        viewBox="0 0 50 50"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M25 3 L31 18 L47 19 L34 29 L39 45 L25 36 L11 45 L16 29 L3 19 L19 18 Z" fill="#FF8FB1" stroke="#2B2D42" stroke-width="3" stroke-linejoin="round"/>
      </svg>
      <svg
        class="hroofy-floater hroofy-floater--hide-mobile"
        style="--x: 8%; --y: 78%; --size: 38px; --d: 8s; --delay: -4s;"
        viewBox="0 0 50 50"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M25 3 L31 18 L47 19 L34 29 L39 45 L25 36 L11 45 L16 29 L3 19 L19 18 Z" fill="#A66CFF" stroke="#2B2D42" stroke-width="3" stroke-linejoin="round"/>
      </svg>

      {%- comment -%} Cloud {%- endcomment -%}
      <svg
        class="hroofy-floater hroofy-floater--hide-mobile"
        style="--x: 30%; --y: 4%; --size: 110px; --d: 12s; --o: 0.8;"
        viewBox="0 0 120 60"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M30 50 Q8 50 10 34 Q12 20 28 22 Q32 6 52 8 Q70 2 78 20 Q100 16 104 34 Q110 50 88 50 Z" fill="#ffffff"/>
      </svg>

      {%- comment -%} Letters & numbers {%- endcomment -%}
      <span class="hroofy-floater hroofy-floater--glyph" style="--x: 16%; --y: 40%; --size: 54px; --c: #FFD23F; --d: 7s; --delay: -1s;">أ</span>
      <span class="hroofy-floater hroofy-floater--glyph hroofy-floater--hide-mobile" style="--x: 40%; --y: 62%; --size: 44px; --c: #5B8DEF; --d: 9s; --delay: -5s;">ب</span>
      <span class="hroofy-floater hroofy-floater--glyph" style="--x: 82%; --y: 52%; --size: 50px; --c: #2EC4B6; --d: 8s; --delay: -2s;">A</span>
      <span class="hroofy-floater hroofy-floater--glyph hroofy-floater--hide-mobile" style="--x: 66%; --y: 88%; --size: 46px; --c: #FF8FB1; --d: 6s; --delay: -3s;">B</span>
      <span class="hroofy-floater hroofy-floater--glyph" style="--x: 92%; --y: 30%; --size: 42px; --c: #FF6B4A; --d: 7.5s; --delay: -4s;">3</span>
      <span class="hroofy-floater hroofy-floater--glyph hroofy-floater--hide-mobile" style="--x: 24%; --y: 90%; --size: 40px; --c: #7BD389; --d: 10s; --delay: -6s;">٢</span>
    </div>
  {%- endif -%}

  <div class="hroofy-hero__inner">
    <div class="hroofy-hero__content">
      {%- if s.eyebrow != blank -%}
        <span class="hroofy-hero__eyebrow">
          <span class="hroofy-hero__eyebrow-dot" aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </span>
      {%- endif -%}

      <h1 id="{{ hero_id }}-title" class="hroofy-hero__title">
        {{ s.heading | escape }}
        {%- if s.heading_highlight != blank %}
          <span class="hroofy-hero__highlight">{{ s.heading_highlight | escape }}</span>
        {%- endif -%}
      </h1>

      {%- if s.subheading != blank -%}
        <div class="hroofy-hero__sub">{{ s.subheading }}</div>
      {%- endif -%}

      <div class="hroofy-hero__actions">
        {%- if s.button_label != blank -%}
          <a
            class="hroofy-btn hroofy-btn--primary"
            href="{{ s.button_link | default: routes.all_products_collection_url }}"
          >
            {{ s.button_label | escape }}
            <span class="hroofy-btn__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if s.secondary_label != blank -%}
          <a
            class="hroofy-btn hroofy-btn--secondary"
            href="{{ s.secondary_link | default: routes.collections_url }}"
          >
            {{ s.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hroofy-hero__badges" role="list">
          {%- for block in section.blocks -%}
            <li
              class="hroofy-badge"
              style="--badge-color: {{ block.settings.color }};"
              {{ block.shopify_attributes }}
            >
              <span class="hroofy-badge__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'paper' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 16h5"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.5-7 10-7 10z"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
                  {%- when 'pencil' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3"/></svg>
                  {%- when 'screen-off' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4M4 3l16 16"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.2l7.1-.6z"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hroofy-hero__visual">
      <div class="hroofy-hero__blob" aria-hidden="true"></div>

      {%- if s.sticker_text != blank -%}
        <div class="hroofy-hero__sticker">{{ s.sticker_text | escape }}</div>
      {%- endif -%}

      <div class="hroofy-hero__media">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) 460px, 90vw',
              widths: '400, 600, 800, 1000, 1200',
              alt: s.image.alt
          }}
        {%- else -%}
          <svg
            class="hroofy-hero__placeholder"
            viewBox="0 0 460 520"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="كتاب تلوين حروفي"
          >
            <rect width="460" height="520" fill="#FFF4DC"/>
            <rect x="60" y="50" width="340" height="420" rx="28" fill="#FF6B4A"/>
            <rect x="60" y="50" width="40" height="420" rx="14" fill="#E2553A"/>
            <rect x="120" y="90" width="250" height="250" rx="30" fill="#ffffff"/>
            <text x="245" y="250" text-anchor="middle" font-family="'Baloo Bhaijaan 2', Cairo, sans-serif" font-size="190" font-weight="800" fill="#FFD23F" stroke="#2B2D42" stroke-width="8" paint-order="stroke">أ</text>
            <text x="245" y="400" text-anchor="middle" font-family="'Baloo Bhaijaan 2', Cairo, sans-serif" font-size="46" font-weight="800" fill="#ffffff">حروفي</text>
