{% doc %}
  Hroofy | حروفي — Cart goal / upsell progress bar (free shipping + free gift).

  Rendered inside snippets/cart-drawer.liquid. Values come from shop metafields
  (Shopify admin > Settings > Custom data > Shop):
    - hroofy.free_shipping_threshold  (number_integer, store currency, default 750)
    - hroofy.gift_threshold           (number_integer, store currency, default 1500)
    - hroofy.gift_variant             (variant_reference) the free gift variant

  The free gift itself is made free by the automatic "Buy X Get Y" discount
  (Hroofy books worth >= gift threshold -> 1 gift at 100% off). Shopify does not
  add discount gifts to the cart on its own, so this component:
    - shows an "add my free gift" button once the threshold is reached;
    - removes the gift automatically if the cart drops below the threshold,
      so the customer is never charged for it by surprise.
  The gift line is excluded from the progress total.

  Cart changes are announced with Shopify standard events (`@shopify/events`
  CartLinesUpdateEvent) including the re-rendered drawer section, so Horizon's
  drawer and cart bubble refresh themselves.

  @param {string} [context] - 'drawer' or 'page' (styling hook)
{% enddoc %}

{%- liquid
  assign context = context | default: 'drawer'

  assign ship_threshold = 750
  if shop.metafields.hroofy.free_shipping_threshold.value != blank
    assign ship_threshold = shop.metafields.hroofy.free_shipping_threshold.value
  endif
  assign gift_threshold = 1500
  if shop.metafields.hroofy.gift_threshold.value != blank
    assign gift_threshold = shop.metafields.hroofy.gift_threshold.value
  endif

  assign gift_variant = shop.metafields.hroofy.gift_variant.value
  assign gift_variant_id = ''
  if gift_variant != blank and gift_variant.available
    assign gift_variant_id = gift_variant.id
  endif

  assign ship_cents = ship_threshold | times: 100
  assign gift_cents = gift_threshold | times: 100
  if gift_cents <= ship_cents
    assign gift_cents = ship_cents | times: 2
  endif

  assign total = cart.total_price
  assign gift_line_key = ''
  for item in cart.items
    if gift_variant_id != blank and item.variant_id == gift_variant_id
      assign gift_line_key = item.key
      assign total = total | minus: item.final_line_price
    endif
  endfor
  if total < 0
    assign total = 0
  endif

  assign percent = total | times: 100 | divided_by: gift_cents
  if percent > 100
    assign percent = 100
  endif
  assign ship_marker = ship_cents | times: 100 | divided_by: gift_cents

  if total < ship_cents
    assign goal_state = 'shipping'
    assign remaining = ship_cents | minus: total
  elsif total < gift_cents
    assign goal_state = 'gift'
    assign remaining = gift_cents | minus: total
  else
    assign goal_state = 'done'
    assign remaining = 0
  endif

  assign gift_name = 'كتيب تلوين الجيب السحري'
  if gift_variant != blank
    assign gift_name = gift_variant.product.title | split: ' - ' | first
  endif

  assign msg_shipping = 'باقي [amount] وتحصل على شحن مجاني 🚚'
  assign msg_gift = '🎉 الشحن بقى مجاني! زوّد [amount] وخد [gift] هدية 🎁'
  assign msg_done = '🏆 مبروك! شحن مجاني + [gift] هدية مع طلبك'
  assign msg_gift = msg_gift | replace: '[gift]', gift_name
  assign msg_done = msg_done | replace: '[gift]', gift_name

  assign amount_html = remaining | money | prepend: '<strong>' | append: '</strong>'

  assign show_gift_button = false
  if goal_state == 'done' and gift_variant_id != blank and gift_line_key == blank
    assign show_gift_button = true
  endif
  assign show_gift_status = false
  if goal_state == 'done' and gift_line_key != blank
    assign show_gift_status = true
  endif
-%}

<hroofy-cart-goal
  class="hroofy-goal hroofy-goal--{{ context }}"
  data-ship-cents="{{ ship_cents }}"
  data-gift-cents="{{ gift_cents }}"
  data-total-cents="{{ total }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-gift-variant="{{ gift_variant_id }}"
  data-gift-line="{{ gift_line_key }}"
  data-msg-shipping="{{ msg_shipping | escape }}"
  data-msg-gift="{{ msg_gift | escape }}"
  data-msg-done="{{ msg_done | escape }}"
  data-state="{{ goal_state }}"
>
  <p class="hroofy-goal__message" aria-live="polite">
    {%- case goal_state -%}
      {%- when 'shipping' -%}
        {{ msg_shipping | replace: '[amount]', amount_html }}
      {%- when 'gift' -%}
        {{ msg_gift | replace: '[amount]', amount_html }}
      {%- else -%}
        {{ msg_done }}
    {%- endcase -%}
  </p>

  {%- if gift_variant_id != blank -%}
    <div class="hroofy-goal__gift" data-gift-add-wrap {% unless show_gift_button %}hidden{% endunless %}>
      <button type="button" class="hroofy-goal__gift-button" data-gift-add>
        🎁 أضف هديتي المجانية
      </button>
    </div>
    <div class="hroofy-goal__gift" data-gift-status-wrap {% unless show_gift_status %}hidden{% endunless %}>
      <p class="hroofy-goal__gift-status">✅ هديتك في السلة ومجانية بالكامل</p>
    </div>
  {%- endif -%}

  <div
    class="hroofy-goal__track"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="{{ percent }}"
    aria-label="التقدم نحو الهدايا"
  >
    <div class="hroofy-goal__fill" style="width: {{ percent }}%;"></div>
    <span
      class="hroofy-goal__milestone{% if total >= ship_cents %} is-reached{% endif %}"
      style="inset-inline-start: {{ ship_marker }}%;"
      data-milestone="shipping"
      title="شحن مجاني"
    >🚚</span>
    <span
      class="hroofy-goal__milestone hroofy-goal__milestone--end{% if total >= gift_cents %} is-reached{% endif %}"
      data-milestone="gift"
      title="كتاب هدية"
    >🎁</span>
  </div>

  <div class="hroofy-goal__labels" aria-hidden="true">
    <span style="inset-inline-start: {{ ship_marker }}%;">{{ ship_cents | money_without_trailing_zeros }}</span>
    <span class="hroofy-goal__labels-end">{{ gift_cents | money_without_trailing_zeros }}</span>
  </div>
</hroofy-cart-goal>

{% style %}
  .hroofy-goal {
    display: block;
    margin: 12px 0 18px;
    padding: 14px 16px 26px;
    border-radius: 22px;
    background: linear-gradient(135deg, #fff4d6, #ffe3ec);
    color: #2b2d42;
    font-family: var(--font-body--family, 'Cairo', system-ui, sans-serif);
    box-shadow:
      0 5px 0 rgb(0 0 0 / 0.05),
      inset 0 -3px 0 rgb(0 0 0 / 0.04);
  }

  .hroofy-goal--drawer {
    margin-inline: var(--cart-drawer-padding, 16px);
  }

  .hroofy-goal__message {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
  }

  .hroofy-goal__message strong {
    color: #cc3f25;
    font-weight: 800;
  }

  .hroofy-goal__track {
    position: relative;
    height: 16px;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.08);
  }

  .hroofy-goal__fill {
    height: 100%;
    max-width: 100%;
    border-radius: inherit;
    background: repeating-linear-gradient(-45deg, #ff6b4a 0 10px, #ff8f73 10px 20px);
    background-size: 28px 28px;
    animation: hroofy-goal-stripes 1s linear infinite;
    transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hroofy-goal[data-state='gift'] .hroofy-goal__fill {
    background: repeating-linear-gradient(-45deg, #2ec4b6 0 10px, #5ad8cc 10px 20px);
  }

  .hroofy-goal[data-state='done'] .hroofy-goal__fill {
    background: repeating-linear-gradient(-45deg, #7bd389 0 10px, #9be3a6 10px 20px);
  }

  .hroofy-goal__milestone {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ffffff;
    font-size: 15px;
    line-height: 1;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 3px #ffd23f,
      0 4px 0 rgb(0 0 0 / 0.1);
    filter: grayscale(1);
    transition:
      filter 0.3s ease,
      transform 0.3s ease;
  }

  [dir='rtl'] .hroofy-goal__milestone {
    transform: translate(50%, -50%);
  }

  .hroofy-goal__milestone--end {
    inset-inline-end: -6px;
    inset-inline-start: auto;
    transform: translateY(-50%);
  }

  [dir='rtl'] .hroofy-goal__milestone--end {
    transform: translateY(-50%);
  }

  .hroofy-goal__milestone.is-reached {
    filter: none;
    box-shadow:
      0 0 0 3px #7bd389,
      0 4px 0 rgb(0 0 0 / 0.1);
    animation: hroofy-goal-bounce 0.6s ease;
  }

  .hroofy-goal__labels {
    position: relative;
    height: 0;
    font-size: 11px;
    font-weight: 700;
    opacity: 0.7;
  }

  .hroofy-goal__labels span {
    position: absolute;
    top: 20px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  [dir='rtl'] .hroofy-goal__labels span {
    transform: translateX(50%);
  }

  .hroofy-goal__labels .hroofy-goal__labels-end {
    inset-inline-end: 0;
    transform: none;
  }

  [dir='rtl'] .hroofy-goal__labels .hroofy-goal__labels-end {
    transform: none;
  }

  @keyframes hroofy-goal-stripes {
    to {
      background-position: 28px 0;
    }
  }

  @keyframes hroofy-goal-bounce {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hroofy-goal *,
    .hroofy-goal__fill {
      animation: none !important;
      transition: none !important;
    }
  }

  .hroofy-goal__gift {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 14px;
  }

  .hroofy-goal__gift[hidden] {
    display: none;
  }

  .hroofy-goal__gift-button {
    appearance: none;
    border: 0;
    cursor: pointer;
    min-height: 44px;
    padding: 10px 22px;
    border-radius: 999px;
    background: #ff6b4a;
    color: #2b2d42;
    font-family: var(--font-heading--family, 'Baloo Bhaijaan 2', 'Cairo', sans-serif);
    font-weight: 800;
    font-size: 16px;
    box-shadow: 0 5px 0 #e2553a;
    animation: hroofy-goal-bounce 1.6s ease-in-out infinite;
  }

  .hroofy-goal__gift-button:hover {
    transform: translateY(-2px);
  }

  .hroofy-goal__gift-button:focus-visible {
    outline: 3px dashed #2b2d42;
    outline-offset: 3px;
  }

  .hroofy-goal__gift-button[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
    animation: none;
  }

  .hroofy-goal__gift-status {
    margin: 0;
    font-weight: 800;
    font-size: 14px;
    color: #2f7d3b;
  }
{% endstyle %}

<script type="module">
  if (!customElements.get('hroofy-cart-goal')) {
    let events = null;
    try {
      events = await import('@shopify/events');
    } catch (error) {
      events = null;
    }

    const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    const SECTION_ID = 'cart-drawer-section';

    class HroofyCartGoal extends HTMLElement {
      connectedCallback() {
        this.onLinesUpdate = this.onLinesUpdate.bind(this);
        this.onAddClick = this.onAddClick.bind(this);
        if (events && events.StandardEvents) {
          document.addEventListener(events.StandardEvents.cartLinesUpdate, this.onLinesUpdate);
        }
        this.querySelector('[data-gift-add]')?.addEventListener('click', this.onAddClick);
        this.maybeRemoveGift();
      }

      disconnectedCallback() {
        if (events && events.StandardEvents) {
          document.removeEventListener(events.StandardEvents.cartLinesUpdate, this.onLinesUpdate);
        }
      }

      get giftVariantId() {
        return Number(this.dataset.giftVariant || 0);
      }

      /* Re-sync when any other component changes the cart. */
      onLinesUpdate(event) {
        if (event.target === this) return;
        event.promise
          ?.then(({ detail }) => (detail && detail.items ? { items: detail.items } : this.fetchCart()))
          .then((cart) => cart && this.render(cart))
          .catch(() => {});
      }

      async fetchCart() {
        const response = await fetch(`${root}cart.js`, { headers: { Accept: 'application/json' } });
        if (!response.ok) return null;
        return response.json();
      }

      /* Shared request + standard-event announcement so the drawer re-renders. */
      async mutate(url, body, action, lines) {
        const deferred = events ? events.CartLinesUpdateEvent.createPromise() : null;
        if (deferred) {
          this.dispatchEvent(
            new events.CartLinesUpdateEvent({ action, context: 'cart', lines, promise: deferred.promise })
          );
        }
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ ...body, sections: SECTION_ID, sections_url: window.location.pathname }),
          });
          const data = await response.json();
          if (!response.ok || data.status) throw new Error(data.description || data.message || 'Cart error');
          const cart = await this.fetchCart();
          if (deferred) {
            deferred.resolve({
              cart: events.CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
              detail: {
                items: cart.items,
                sections: data.sections,
                source: 'hroofy-cart-goal',
                sourceId: 'hroofy-cart-goal',
                itemCount: cart.item_count,
              },
            });
          } else {
            window.location.reload();
          }
          this.render(cart);
          return cart;
        } catch (error) {
          deferred?.reject(error);
          return null;
        }
      }

      async onAddClick(event) {
        const button = event.currentTarget;
        if (!this.giftVariantId || button.getAttribute('aria-busy') === 'true') return;
        button.setAttribute('aria-busy', 'true');
        await this.mutate(
          `${root}cart/add.js`,
          { items: [{ id: this.giftVariantId, quantity: 1 }] },
          'add',
          [{ merchandiseId: String(this.giftVariantId), quantity: 1 }]
        );
        button.removeAttribute('aria-busy');
      }

      /* Never leave a paid gift in the cart below the threshold. */
      async maybeRemoveGift() {
        const lineKey = this.dataset.giftLine;
        if (!lineKey || this.dataset.state === 'done' || this.removing) return;
        this.removing = true;
        await this.mutate(`${root}cart/change.js`, { id: lineKey, quantity: 0 }, 'update', [{ id: lineKey, quantity: 0 }]);
        this.removing = false;
      }

      format(cents, currency) {
        try {
          return new Intl.NumberFormat(document.documentElement.lang || 'ar', {
            style: 'currency',
            currency: currency || this.dataset.currency || 'EGP',
            maximumFractionDigits: cents % 100 === 0 ? 0 : 2,
          }).format(cents / 100);
        } catch (error) {
          return `${(cents / 100).toFixed(2)} ${currency || ''}`;
        }
      }

      render(cart) {
        const items = cart.items || [];
        const giftLine = items.find((item) => this.giftVariantId && item.variant_id === this.giftVariantId);
        let total = typeof cart.total_price === 'number'
          ? cart.total_price
          : items.reduce((sum, item) => sum + (item.final_line_price || 0), 0);
        if (giftLine) total -= giftLine.final_line_price || 0;
        total = Math.max(0, total);

        const ship = Number(this.dataset.shipCents);
        const gift = Number(this.dataset.giftCents);
        const percent = Math.min(100, Math.floor((total * 100) / gift));
        let state = 'done';
        let remaining = 0;
        if (total < ship) {
          state = 'shipping';
          remaining = ship - total;
        } else if (total < gift) {
          state = 'gift';
          remaining = gift - total;
        }

        this.dataset.state = state;
        this.dataset.totalCents = String(total);
        this.dataset.giftLine = giftLine ? giftLine.key : '';

        const template = this.dataset[`msg${state.charAt(0).toUpperCase()}${state.slice(1)}`] || '';
        const message = this.querySelector('.hroofy-goal__message');
        if (message) {
          message.textContent = '';
          template.split('[amount]').forEach((part, index, parts) => {
            message.append(document.createTextNode(part));
            if (index < parts.length - 1) {
              const strong = document.createElement('strong');
              strong.textContent = this.format(remaining, cart.currency);
              message.append(strong);
            }
          });
        }

        const fill = this.querySelector('.hroofy-goal__fill');
        if (fill) fill.style.width = `${percent}%`;
        this.querySelector('.hroofy-goal__track')?.setAttribute('aria-valuenow', String(percent));
        this.querySelector('[data-milestone="shipping"]')?.classList.toggle('is-reached', total >= ship);
        this.querySelector('[data-milestone="gift"]')?.classList.toggle('is-reached', total >= gift);

        const addWrap = this.querySelector('[data-gift-add-wrap]');
        const statusWrap = this.querySelector('[data-gift-status-wrap]');
        if (addWrap) addWrap.hidden = !(state === 'done' && !giftLine);
        if (statusWrap) statusWrap.hidden = !(state === 'done' && giftLine);

        this.maybeRemoveGift();
      }
    }

    customElements.define('hroofy-cart-goal', HroofyCartGoal);
  }
</script>
