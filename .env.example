# Copy to .env and edit. Every setting has a safe default; nested settings use "__".

# ---- Mode ------------------------------------------------------------------------------
# SHADOW_PAPER (default): live data, paper fills, NO private key needed or read.
# LIVE: real trades. Refuses to start until the shadow journal passes the readiness gate.
EXECUTION_MODE=SHADOW_PAPER

# ---- Endpoints -------------------------------------------------------------------------
# A free Helius key (https://dashboard.helius.dev) is strongly recommended: the public endpoint
# serves getTransaction at well under 1 tx/s and drops websocket subscriptions.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# WS_URL is derived from RPC_URL when empty.
WS_URL=
RPC_RPS=8
# poll = no websocket (slower signals, works everywhere)
LISTENER_MODE=ws

# Jupiter: free lite host by default. With a key from https://portal.jup.ag the bot switches
# to api.jup.ag automatically; raise JUPITER_RPS to your plan's limit.
JUPITER_API_KEY=
JUPITER_RPS=0.8

# ---- Paper trading ---------------------------------------------------------------------
SHADOW_STARTING_SOL=1.0
SHADOW_LATENCY_HAIRCUT_BPS=75

# ---- Notifications (optional) ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Thresholds (examples; defaults follow the engineering mandate) ---------------------
# SAFETY__MIN_LIQUIDITY_USD=25000
# SAFETY__MIN_MARKET_CAP_USD=60000
# SAFETY__MAX_CHASE_PCT=0.12
# SAFETY__MAX_ROUNDTRIP_LOSS_PCT=0.05
# RISK__POSITION_SIZE_FRAC=0.10
# RISK__MAX_OPEN_POSITIONS=3
# RISK__MAX_LEG_COST_PCT=0.012        # PumpSwap low caps charge ~1.25%/leg: see docs/ARCHITECTURE_REVIEW.md
# RISK__DAILY_LOSS_LIMIT_FRAC=0.15
# RISK__PRIORITY_MODE=PRIORITY_FEE     # or JITO_TIP
# EXITS__HARD_STOP_LOSS=0.22
# EXITS__TRAILING_STOP_PCT=0.15
# SCORER__LOOKBACK_DAYS=30
# SCORER__MAX_SIGNATURES_PER_WALLET=1500

# ---- Momentum signal source (OFF by default) -------------------------------------------
# Breakout momentum on liquid, 6h+ old memecoins, entering through the SAME safety gate, sizing,
# circuit breaker and exits as a copied whale buy. Works without approved_wallets.json.
# Tune thresholds first with:  python main.py momentum-scan   (observation only, never trades)
# MOMENTUM__ENABLED=true
# MOMENTUM__MIN_RETURN=0.08            # >= +8% over the 5-minute window ...
# MOMENTUM__MAX_RETURN=0.60            # ... but never a vertical candle
# MOMENTUM__MIN_BUYS_M5=25
# MOMENTUM__MIN_BUY_RATIO=0.60
# MOMENTUM__SIZE_FRAC=0.05             # half the base copy size: no track record yet
# MOMENTUM__MAX_OPEN=1

# ---- LIVE only: secrets ----------------------------------------------------------------
# Use a DEDICATED burner wallet funded with only your risk budget. Prefer a keypair file:
#   solana-keygen new -o ~/.config/copybot/burner.json && chmod 600 ~/.config/copybot/burner.json
# KEYPAIR_PATH=~/.config/copybot/burner.json
# PRIVATE_KEY=   # base58 secret key (less safe than a chmod-600 file)

# ---- Optional AI forensics (pip install --require-hashes -r requirements-ai.txt) -------
# Veto-only wallet judge + post-buy overwatch. Never in the pre-buy path; the bot runs
# without it. `python main.py doctor` probes the key and picks the first served model.
# LLM__API_KEY=
# LLM__BASE_URL=            # empty = Anthropic API; or any Anthropic-compatible endpoint
# LLM__MODEL=               # empty = auto-probe (claude-sonnet-5-5 first)
